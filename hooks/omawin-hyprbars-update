#!/usr/bin/env bash
# Rebuild hyprbars after an Omarchy update and require the running compositor to attach it.
set -euo pipefail

ENSURE="${HOME}/.local/bin/omawin-ensure-hyprbars"
if [[ ! -x "$ENSURE" ]]; then
  printf 'omawin: %s is missing. Run setup.sh again.\n' "$ENSURE" >&2
  exit 1
fi

"$ENSURE"
