#!/usr/bin/env python3
"""Write ~/.config/hypr/titlebar-colors.lua from the active Omarchy theme."""

from __future__ import annotations

import os
import re
import sys
from pathlib import Path

HEX = re.compile(r"^#([0-9A-Fa-f]{6})([0-9A-Fa-f]{2})?$")
RGB = re.compile(r"^rgba?\([^)]+\)$")
TOML_COLOR = re.compile(
    r"""^\s*([A-Za-z0-9_-]+)\s*=\s*["']([^"']+)["']"""
)
HYPR_BORDER = re.compile(
    r"""^\s*local\s+active_border_color\s*=\s*["']([^"']+)["']"""
)


def env_or(name: str, fallback: str) -> str:
    value = os.environ.get(name)
    if value is None or value == "":
        return fallback
    return value


def to_hypr_color(value: str) -> str | None:
    value = value.strip()
    if not value:
        return None
    match = HEX.match(value)
    if match:
        body = match.group(1).lower()
        alpha = match.group(2)
        if alpha:
            return f"rgba({body}{alpha.lower()})"
        return f"rgb({body})"
    if RGB.match(value):
        return value
    return None


def load_palette(path: Path) -> dict[str, str]:
    palette: dict[str, str] = {}
    if not path.is_file():
        return palette
    for line in path.read_text(errors="replace").splitlines():
        match = TOML_COLOR.match(line)
        if match:
            palette[match.group(1)] = match.group(2)
    return palette


def first_color(palette: dict[str, str], *keys: str) -> str | None:
    for key in keys:
        raw = palette.get(key)
        if raw is None:
            continue
        color = to_hypr_color(raw)
        if color is not None:
            return color
        nested = to_hypr_color(palette.get(raw, ""))
        if nested is not None:
            return nested
    return None


def active_border_from_theme(theme_dir: Path) -> str | None:
    hyprland = theme_dir / "hyprland.lua"
    if not hyprland.is_file():
        return None
    for line in hyprland.read_text(errors="replace").splitlines():
        match = HYPR_BORDER.match(line)
        if match:
            return to_hypr_color(match.group(1))
    return None


def main() -> int:
    home = Path(os.environ.get("HOME") or Path.home())
    config_home = Path(env_or("XDG_CONFIG_HOME", str(home / ".config")))
    state_home = Path(env_or("XDG_STATE_HOME", str(home / ".local/state")))
    theme_dir = state_home / "omarchy" / "current" / "theme"
    out_path = config_home / "hypr" / "titlebar-colors.lua"

    palette = load_palette(theme_dir / "colors.toml")
    background = (
        first_color(palette, "background", "bg", "color0") or "rgb(222222)"
    )
    foreground = (
        first_color(palette, "foreground", "fg", "color7", "light_foreground")
        or "rgb(eeeeee)"
    )
    accent = (
        active_border_from_theme(theme_dir)
        or first_color(
            palette,
            "hyprland_active_border",
            "accent",
            "blue",
            "color4",
        )
        or foreground
    )

    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(
        "\n".join(
            [
                "-- Generated by omawin from the active Omarchy theme. Do not edit.",
                "return {",
                f'  background = "{background}",',
                f'  foreground = "{foreground}",',
                f'  accent = "{accent}",',
                "}",
                "",
            ]
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
